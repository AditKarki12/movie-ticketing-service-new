{
  "mappings": {
    "properties": {
      "bookingId": {
        "type": "keyword"
      },
      "userId": {
        "type": "long"
      },
      "userEmail": {
        "type": "keyword"
      },
      "showtimeId": {
        "type": "long"
      },
